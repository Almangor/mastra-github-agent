# --- required -----------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- model routing (ADR-0004) --------------------------------------------------
CEO_SUPERVISOR_MODEL=claude-opus-5
CEO_SUBAGENT_MODEL=claude-sonnet-5
CEO_REVIEWER_MODEL=claude-sonnet-5

# --- executive state ------------------------------------------------------------
CEO_DB_URL=file:./ceo-state.db

# --- Slack control plane (plan §1) ----------------------------------------------
# Without these the runtime still boots; Slack traffic is simply not served.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Deny-by-default allowlist. A missing or malformed file denies everything.
CEO_ACCESS_POLICY_PATH=./config/access-policy.json

# --- integrations (all optional; absent = adapter reports itself disabled) -------
GITHUB_TOKEN=
LINEAR_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
CRM_API_KEY=
FINANCE_API_KEY=

# --- durability -----------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- learning safety switches (plan §3) -----------------------------------------
# Off by default. Turning this on enables proposal generation only — promotion
# still requires validation, evals, and a human.
CEO_LEARNING_ENABLED=false
CEO_CANARY_TRAFFIC_PERCENT=10

# Feature-flagged betas the plan keeps off the critical path.
CEO_ENABLE_AGENT_CONTROLLER=false
CEO_ENABLE_MASTRA_GOALS=false
