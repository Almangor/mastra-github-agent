{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default", "!{projectRoot}/**/*.spec.ts", "!{projectRoot}/**/*.eval.ts"],
    "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json"]
  },
  "targetDefaults": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "evals": {
      "dependsOn": ["^typecheck"],
      "inputs": ["default", "^production"],
      "cache": true
    }
  },
  "defaultBase": "main"
}
